rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the authenticated user is whitelisted
    function isSignedIn() {
      return request.auth != null;
    }

    function signedInEmail() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email
        : '';
    }

    function isWhitelisted() {
      return signedInEmail() in ['kevin@bloxit.be', 'kevin@smartpeak.be', 'ledsrepair@gmail.com', 'ruben@smartpeak.be'];
    }

    function leadPath(leadId) {
      return /databases/$(database)/documents/leads/$(leadId);
    }

    function isShortString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function isOptionalShortString(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalNumber(data, key, min, max) {
      return !(key in data) || data[key] == null || (data[key] is number && data[key] >= min && data[key] <= max);
    }

    function isOptionalBool(data, key) {
      return !(key in data) || data[key] == null || data[key] is bool;
    }

    function isOptionalNumberOrRange(data, key, min, max) {
      return !(key in data)
        || (data[key] is number && data[key] >= min && data[key] <= max)
        || (
          data[key] is map
          && data[key].keys().hasOnly(['min', 'max'])
          && data[key].min is number
          && data[key].max is number
          && data[key].min >= min
          && data[key].max <= max
        );
    }

    function isValidDailyCompact(daily) {
      return daily is map
        && daily.keys().hasOnly(['startDate', 'afname', 'injectie', 'afnamedag', 'afnamenacht', 'injectiedag', 'injectienacht'])
        && isShortString(daily.startDate, 10)
        && daily.afname is list && daily.afname.size() <= 3660
        && daily.injectie is list && daily.injectie.size() <= 3660
        && daily.afnamedag is list && daily.afnamedag.size() <= 3660
        && daily.afnamenacht is list && daily.afnamenacht.size() <= 3660
        && daily.injectiedag is list && daily.injectiedag.size() <= 3660
        && daily.injectienacht is list && daily.injectienacht.size() <= 3660;
    }

    function isOptionalLeadResult(data) {
      return !('result' in data)
        || data.result == null
        || (
          data.result is map
          && data.result.keys().hasOnly([
            'isRange', 'bestConfigType', 'configTypes', 'configs',
            'batteryCapKwh', 'batteryInverterKw', 'roiYears',
            'recoveryPctFull', 'recoveryPctPartial', 'qualifyingDays',
            'partialDays', 'annualSavingEur', 'daysInWindow', 'isFullYear'
          ])
          // Keep this deliberately shape-focused. The lead calculator may emit
          // either flat numbers or min/max ranges for many fields; validating
          // every numeric leaf made valid full-result writes brittle and caused
          // misleading permission-denied errors for public lead submissions.
          && isOptionalBool(data.result, 'isRange')
          && isOptionalShortString(data.result, 'bestConfigType', 80)
          && (!('configTypes' in data.result) || (data.result.configTypes is list && data.result.configTypes.size() <= 5))
          && (!('configs' in data.result) || (data.result.configs is list && data.result.configs.size() <= 5))
        );
    }

    function isValidLeadCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'customerName', 'email', 'csvDailyCompact', 'pvInverterKw', 'pricePerKwh',
          'houseAgeOver10Years', 'defaultsUsed', 'notes', 'result', 'effectiveBtw',
          'keuring', 'status', 'createdAt', 'hotLeadAt', 'deletedAt', 'resultExpiresAt'
        ])
        && isShortString(data.customerName, 120)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && (!('csvDailyCompact' in data) || isValidDailyCompact(data.csvDailyCompact))
        && isOptionalNumber(data, 'pvInverterKw', 0.1, 100)
        && isOptionalNumber(data, 'pricePerKwh', 0.01, 2)
        && isOptionalBool(data, 'houseAgeOver10Years')
        && (!('defaultsUsed' in data) || data.defaultsUsed is map)
        && isOptionalShortString(data, 'notes', 2000)
        && isOptionalLeadResult(data)
        && isOptionalNumber(data, 'effectiveBtw', 0, 21)
        && isOptionalBool(data, 'keuring')
        && data.status == 'cold_lead'
        // Web clients normally send FieldValue.serverTimestamp(), but accepting
        // a very recent timestamp keeps the rule testable via the REST API and
        // avoids brittle exact timestamp comparisons.
        && data.createdAt is timestamp
        && data.createdAt <= request.time
        && data.createdAt > request.time - duration.value(5, 'm')
        && data.hotLeadAt == null
        && data.deletedAt == null
        && data.resultExpiresAt is timestamp
        && data.resultExpiresAt > request.time
        // Client creates this timestamp before the Firestore request reaches
        // the server. Allow a small clock/network skew around the 30-day TTL.
        && data.resultExpiresAt <= request.time + duration.value(31, 'd');
    }

    function isPublicLeadGet() {
      return resource.data.deletedAt == null
        && (!('resultExpiresAt' in resource.data) || resource.data.resultExpiresAt > request.time);
    }

    function isPublicHotLeadUpdate() {
      return resource.data.status == 'cold_lead'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'hotLeadAt'])
        && request.resource.data.status == 'hot_lead'
        && request.resource.data.hotLeadAt == request.time;
    }

    function hasValidMailEnvelope(kind) {
      let data = request.resource.data;
      return data.keys().hasOnly(['kind', 'leadId', 'to', 'message', 'createdAt'])
        && data.kind == kind
        && data.leadId is string
        && data.leadId.size() > 0
        && data.leadId.size() <= 128
        && data.createdAt == request.time
        && data.message is map
        && data.message.keys().hasOnly(['subject', 'html'])
        && data.message.subject is string
        && data.message.subject.size() > 0
        && data.message.subject.size() <= 200
        && data.message.html is string
        && data.message.html.size() > 0
        && data.message.html.size() <= 50000
        && exists(leadPath(data.leadId));
    }

    function isValidLeadResultMail() {
      let data = request.resource.data;
      return hasValidMailEnvelope('lead_result')
        && data.to is string
        && data.to == get(leadPath(data.leadId)).data.email
        && data.message.subject == 'Je batterij-analyse is klaar SmartPeak';
    }

    function isValidLeadContactMail() {
      let data = request.resource.data;
      return hasValidMailEnvelope('lead_contact')
        && data.to is list
        && data.to.size() == 2
        && 'kevin@smartpeak.be' in data.to
        && 'ruben@smartpeak.be' in data.to
        && data.message.subject.matches('^Nieuwe contactaanvraag:.*$');
    }

    function isValidShareCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly(['payload', 'projectId', 'createdBy', 'createdAt', 'expiresAt'])
        && data.payload is map
        && (data.projectId == null || data.projectId is string)
        && data.createdBy is string
        && data.createdAt == request.time
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(180, 'd');
    }

    function reviewRequestPath(requestId) {
      return /databases/$(database)/documents/reviewRequests/$(requestId);
    }

    function isPublicReviewRequestGet() {
      return resource.data.status == 'active';
    }

    function isValidReviewRequestCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'projectId', 'originalProjectName', 'originalCustomerName', 'suggestedDisplayName',
          'solutionSummary', 'googleReviewUrl', 'status', 'createdAt', 'createdBy', 'updatedAt', 'submittedAt'
        ])
        && isShortString(data.projectId, 160)
        && isOptionalShortString(data, 'originalProjectName', 160)
        && isOptionalShortString(data, 'originalCustomerName', 160)
        && isOptionalShortString(data, 'suggestedDisplayName', 160)
        && (!('solutionSummary' in data) || data.solutionSummary is map)
        && isOptionalShortString(data, 'googleReviewUrl', 500)
        && data.status == 'active'
        && data.createdBy == signedInEmail()
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.submittedAt == null;
    }

    function isPublicReviewRequestSubmissionUpdate() {
      return resource.data.status == 'active'
        && resource.data.submittedAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submittedAt', 'latestReviewId', 'updatedAt'])
        && request.resource.data.submittedAt == request.time
        && isShortString(request.resource.data.latestReviewId, 160)
        && request.resource.data.updatedAt == request.time;
    }

    function isPublishedWebsiteReview() {
      return resource.data.status == 'published' && resource.data.consentWebsite == true;
    }

    function isValidReviewCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'requestId', 'projectId', 'originalProjectName', 'originalCustomerName', 'displayName',
          'rating', 'ratingCommunication', 'ratingPlanning', 'ratingInstallation', 'ratingFinish',
          'shortReview', 'privateFeedback', 'solutionSummary', 'reviewPhotos', 'reviewPhotosPublic', 'consentWebsite', 'consentSocials',
          'googleReviewUrl', 'googleClicked', 'status', 'createdAt', 'updatedAt'
        ])
        && isShortString(data.requestId, 160)
        && exists(reviewRequestPath(data.requestId))
        && get(reviewRequestPath(data.requestId)).data.status == 'active'
        && get(reviewRequestPath(data.requestId)).data.submittedAt == null
        && (data.projectId == null || data.projectId is string)
        && isOptionalShortString(data, 'originalProjectName', 160)
        && isOptionalShortString(data, 'originalCustomerName', 160)
        && isOptionalShortString(data, 'displayName', 160)
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.ratingCommunication is number && data.ratingCommunication >= 1 && data.ratingCommunication <= 5
        && data.ratingPlanning is number && data.ratingPlanning >= 1 && data.ratingPlanning <= 5
        && data.ratingInstallation is number && data.ratingInstallation >= 1 && data.ratingInstallation <= 5
        && data.ratingFinish is number && data.ratingFinish >= 1 && data.ratingFinish <= 5
        && isShortString(data.shortReview, 1200)
        && isOptionalShortString(data, 'privateFeedback', 2000)
        && (!('solutionSummary' in data) || data.solutionSummary == null || data.solutionSummary is map)
        && (!('reviewPhotos' in data) || data.reviewPhotos is list && data.reviewPhotos.size() <= 8)
        && (!('reviewPhotosPublic' in data) || data.reviewPhotosPublic is bool)
        && data.consentWebsite is bool
        && data.consentSocials is bool
        && isOptionalShortString(data, 'googleReviewUrl', 500)
        && data.googleClicked == false
        && data.status == 'submitted'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidPublicReviewProjectPhotoCreate(projectId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'storagePath', 'thumbStoragePath', 'downloadUrl', 'thumbUrl', 'name', 'contentType', 'sizeBytes', 'width', 'height',
          'tag', 'includeInCloseoutPdf', 'includeInInspectionPack', 'showOnWebsite', 'uploadedAt', 'uploadedBy',
          'sourceReviewRequestId', 'sourceReviewId'
        ])
        && isShortString(data.sourceReviewRequestId, 160)
        && exists(reviewRequestPath(data.sourceReviewRequestId))
        && get(reviewRequestPath(data.sourceReviewRequestId)).data.projectId == projectId
        && get(reviewRequestPath(data.sourceReviewRequestId)).data.submittedAt == null
        && data.storagePath is string && data.storagePath.matches('^review-uploads/' + data.sourceReviewRequestId + '/.*')
        && data.thumbStoragePath is string && data.thumbStoragePath.matches('^review-uploads/' + data.sourceReviewRequestId + '/.*')
        && isOptionalShortString(data, 'downloadUrl', 2000)
        && isOptionalShortString(data, 'thumbUrl', 2000)
        && isOptionalShortString(data, 'name', 160)
        && data.contentType is string && data.contentType.matches('^image/.*')
        && data.sizeBytes is number && data.sizeBytes > 0 && data.sizeBytes <= 15728640
        && data.tag == 'review'
        && data.includeInCloseoutPdf == true
        && data.includeInInspectionPack == false
        && data.showOnWebsite is bool
        && data.uploadedAt == request.time
        && data.uploadedBy == 'review-link'
        && isShortString(data.sourceReviewId, 160);
    }

    // ─── Projects ──────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read, write: if isWhitelisted();

      match /comments/{commentId} {
        allow read, write: if isWhitelisted();
      }

      match /photos/{photoId} {
        allow read, write: if isWhitelisted();
        allow create: if isValidPublicReviewProjectPhotoCreate(projectId);
      }

      match /documents/{documentId} {
        allow read, write: if isWhitelisted();
      }
    }

    // ─── Shares (public read, whitelisted create/delete) ─────────
    match /shares/{shareId} {
      allow read:   if !('expiresAt' in resource.data) || resource.data.expiresAt > request.time;
      allow create: if isWhitelisted() && isValidShareCreate();
      allow delete: if isWhitelisted();
      allow update: if false;
    }

    // ─── Reviews (public request + submitted reviews, moderated publishing) ─
    match /reviewRequests/{requestId} {
      allow get:    if isWhitelisted() || isPublicReviewRequestGet();
      allow list:   if isSignedIn();
      allow create: if isSignedIn() && isValidReviewRequestCreate();
      allow update: if isWhitelisted() || isPublicReviewRequestSubmissionUpdate();
      allow delete: if isWhitelisted();
    }

    match /reviews/{reviewId} {
      allow get, list: if isWhitelisted() || isPublishedWebsiteReview();
      allow create:   if isValidReviewCreate();
      allow update, delete: if isWhitelisted();
    }

    // ─── Config ──────────────────────────────────────────────
    // 'products' is publicly readable (lead wizard needs it).
    // 'settings' is writable by whitelisted users.
    // All other config docs are read-only for whitelisted users.
    match /config/{docId} {
      allow read:  if docId == 'products' || isWhitelisted();
      allow write: if docId == 'settings' && isWhitelisted();
    }

    // ─── Leads (public create, public read by ID, whitelisted list) ─
    match /leads/{leadId} {
      allow get:    if isWhitelisted() || isPublicLeadGet();
      allow list:   if isWhitelisted();
      allow create: if isValidLeadCreate();
      allow update: if isWhitelisted() || isPublicHotLeadUpdate();
      allow delete: if isWhitelisted();
    }

    // ─── Mail (trigger email extension) ──────────────────────────
    match /mail/{mailId} {
      allow create: if mailId == request.resource.data.kind + '_' + request.resource.data.leadId
        && (isValidLeadResultMail() || isValidLeadContactMail());
      allow read, update, delete: if false;
    }

    // ─── Product categories ────────────────────────────────────
    match /productCategories/{catId} {
      allow read:   if isWhitelisted();
      allow write:  if isWhitelisted();
    }

    // ─── Product configurations ─────────────────────────────────
    match /productConfigs/{configId} {
      allow read:   if isWhitelisted();
      allow write:  if isWhitelisted();
    }

    // ─── Products ──────────────────────────────────────────────
    match /products/{productId} {
      allow read:   if isWhitelisted();
      allow write:  if isWhitelisted();

      match /photos/{photoId} {
        allow read:   if isWhitelisted();
        allow write:  if isWhitelisted();
      }
      match /datasheets/{dsId} {
        allow read:   if isWhitelisted();
        allow write:  if isWhitelisted();
      }
    }
  }
}
